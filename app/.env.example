# Trading bot configuration
# Copy to app/.env for python app/run_bot.py, or configure the web panel.

# Set to false only when you want real exchange orders.
# Also set LIVE_TRADING_CONFIRMED=true for non-UI live starts.
PAPER_TRADING=true
LIVE_TRADING_CONFIRMED=false
EXCHANGE=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Required by OKX only.
EXCHANGE_PASSPHRASE=

SYMBOLS=BTC/USDT
CANDLE_TF=15m
CANDLE_LIMIT=300
INTERVAL_SECONDS=60
STRATEGY=ai_expert

RISK_PER_TRADE=0.02
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
MAX_POSITIONS=3
MAX_DRAWDOWN_PCT=0.30

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TG_MIN_CONFIDENCE=0.7

# Railway deployment metadata is injected automatically by Railway when present.
# RAILWAY_ENVIRONMENT_NAME=production
# RAILWAY_SERVICE_NAME=trading-bot
