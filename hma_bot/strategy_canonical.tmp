"""Canonical HMA strategy entrypoint.

The production strategy is exported from this file. Historical implementation
layers have semantic module names; no version-numbered files are used.
"""
from __future__ import annotations

import importlib
import sys

import strategy_base as _base
for _name, _value in vars(_base).items():
    if not _name.startswith("__"):
        globals()[_name] = _value

_ALIAS_ORDER = (
    ("strategy_v3", "strategy_structure"),
    ("strategy_v5", "strategy_balanced"),
    ("strategy_v6", "strategy_sentinel"),
    ("strategy_v7", "strategy_adaptive"),
    ("strategy_v8", "strategy_clean"),
    ("strategy_v9", "strategy_sr_entry"),
    ("strategy_v10", "strategy_one_hour"),
    ("strategy_v11", "strategy_smooth"),
    ("strategy_v12", "strategy_gate"),
)

for _legacy_name, _module_name in _ALIAS_ORDER:
    _module = importlib.import_module(_module_name)
    sys.modules[_legacy_name] = _module

_latest = sys.modules["strategy_v12"]
for _name, _value in vars(_latest).items():
    if not _name.startswith("__"):
        globals()[_name] = _value

PrecisionTrendStructure = _latest.PrecisionTrendStructureV12
MTFStructureStrategy = PrecisionTrendStructure
BOT_STRATEGY_VERSION = "5.2"
