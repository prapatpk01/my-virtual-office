# ── OKX credentials ───────────────────────────────────────────────────────
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading ───────────────────────────────────────────────────────────────
# true = paper mode (no real orders), false = live
PAPER_TRADING=true

# Comma-separated OKX perpetual swap symbols
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT

LEVERAGE=20
# 0.05-0.10 (5-10%), clamped automatically; default 0.08 (8%)
RISK_PER_TRADE=0.08

# ── Timeframes (defaults match the strategy spec — usually leave as-is) ────
TIMEFRAME_ENTRY=30m
TIMEFRAME_BIAS=1h
TIMEFRAME_REGIME=4h
