# =============================================================================
# Adaptive SMC MTF V7.0 — branch: claude/my-virtual-office-setup-0ndmyj
# Pipeline: 4H TSS-style -> M15 Market Structure -> M5 AMD -> M1 IFVG
# =============================================================================

# Exchange / execution
EXCHANGE=okx
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSPHRASE=
PAPER_TRADING=true               # true first; false only when ready for live
LEVERAGE=20

# Symbols (OKX perpetual format)
SYMBOLS=XAU/USDT:USDT,SOL/USDT:USDT,XAG/USDT:USDT,XRP/USDT:USDT,HYPE/USDT:USDT,BTC/USDT:USDT
MAX_POSITIONS=2

# Polling. Decisions are still evaluated only once per CLOSED M1 candle.
INTERVAL_SECONDS=30

# Position sizing
# Hard notional cap = ADAPTIVE_MARGIN_USDT * LEVERAGE.
# Risk target = MOM_RISK_USDT / structure-stop distance.
# The bot uses the smaller resulting size.
ADAPTIVE_MARGIN_USDT=20
MOM_RISK_USDT=5.0

# SMC risk geometry
SMC_TP1_R=1.0                  # close 50%
SMC_TP2_R=2.0                  # close all remaining
SMC_BE_LOCK_R=0.10             # after TP1, lock +0.10R / -0.10R
SMC_MIN_SL_PCT=0.0025          # minimum structural stop distance = 0.25%
SMC_MAX_SL_PCT=0.030           # reject setups needing >3.0% stop
SMC_COOLDOWN_1M_BARS=5         # after SL/locked-SL, wait N closed M1 bars

# Persistence. Mount a Railway Volume at /data so live positions/stats survive deploys.
BOT_STATE_DIR=/data
TRADE_LEDGER_FILE=/data/trade_ledger_smc_v7.json

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
