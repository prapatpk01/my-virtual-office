# Virtual Office Configuration
# Copy this file to .env and adjust values for your setup.

# Path to your OpenClaw installation
VO_OPENCLAW_PATH=~/.openclaw

# OpenClaw gateway connection
VO_GATEWAY_URL=ws://host.docker.internal:18789
VO_GATEWAY_HTTP=http://host.docker.internal:18789

# Server ports
VO_PORT=8090
VO_WS_PORT=8091

# Office display name
VO_OFFICE_NAME=Virtual Office
VO_WEATHER_LOCATION=

# Agent Browser VNC password (if using the optional browser service)
# BROWSER_VNC_PASSWORD=changeme

# ── Trading Bot ─────────────────────────────────────────────────────────────
# Production default for Dockerfile.bot is EMA Hybrid Pro.
# Set MODE explicitly if you want another runtime.
MODE=ema_hybrid

# ── OKX / EMA Hybrid Pro ────────────────────────────────────────────────────
# LIVE mode requires all three OKX credentials below.
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
PAPER_TRADING=false

# CCXT unified perpetual symbols
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT
LEVERAGE=20
MARGIN_MODE=isolated
MARGIN_PER_POSITION_USD=20
MAX_POSITIONS=2

# EMA Hybrid risk model
# Strategy builds the actual SL from confirmed swing + 0.15 ATR.
# These values are also used by the inherited execution/recovery layer.
SL_PCT=0.015
TP_PCT=0.015

# EMA Hybrid entry model:
# H1 + M15 EMA20/50/200 alignment
# Fib 50%-61.8% + EMA20/50 pullback
# liquidity sweep + closed M15 price action
# initial RR >= 1:2, final target 3R

# Persistent state / logging
STATE_DIR=state
STATUS_LOG_INTERVAL_SEC=300
STATS_SINCE_DATE=2026-07-30

# Telegram alerts (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Alternative runtimes ────────────────────────────────────────────────────
# MODE=dual       -> DUAL ENTRY PRECISION V1.4
# MODE=regime     -> Signal Regime Bias
# MODE=htf        -> HTF Pullback
# MODE=tpc        -> Trend Pullback Continuation / HMA
