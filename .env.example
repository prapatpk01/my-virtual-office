# ── Exchange ──────────────────────────────────────────────────────────────────
EXCHANGE=okx                    # okx | binance | bybit
EXCHANGE_API_KEY=               # API Key
EXCHANGE_API_SECRET=            # API Secret
EXCHANGE_PASSPHRASE=            # OKX เท่านั้น (Passphrase ตอนสร้าง API Key)

# ── Trading mode ──────────────────────────────────────────────────────────────
PAPER_TRADING=true              # true = ทดสอบ ไม่ใช้เงินจริง | false = Live
SYMBOLS=BTC/USDT                # คั่นด้วย comma ถ้าหลายตัว เช่น BTC/USDT,XAU/USDT
LEVERAGE=1                      # 1 = spot, 5 = margin×5 (OKX futures)
CANDLE_TF=1h                    # primary timeframe (SpotMaster1H ใช้ 1h)
CANDLE_LIMIT=300                # bars ต่อ fetch
INTERVAL_SECONDS=60             # tick ทุก 60 วินาที (strategies ใช้ 30m/4H/1D จาก MTF)

# ── Risk ──────────────────────────────────────────────────────────────────────
TRADE_AMOUNT_USDT=100           # fixed USDT ต่อ trade (เช่น 100 = เทรดครั้งละ 100$)
MAX_POSITIONS=5                 # สูงสุด 5 positions (SpotMaster=1 Grid×3=3 Swing=1)
MAX_DRAWDOWN_PCT=0.30           # หยุดเทรดถ้า drawdown เกิน 30%
RISK_PER_TRADE=0.02             # fallback: 2% ของ balance ต่อ trade

# ── Strategies ────────────────────────────────────────────────────────────────
STRATEGY_SPOT_MASTER=true       # SpotMaster1H (7-layer, 1H entry, max 1 pos)
STRATEGY_SMART_GRID=true        # SmartGridHybrid L1/L2/L3 (Grid/Swing/BO, max 3 pos)
STRATEGY_SWING_MASTER=true      # SwingMaster30m (bidirectional, max 1 pos)

# ── SpotMaster1H params (optional) ───────────────────────────────────────────
# SM_SL=1.5       # SL = 1.5×ATR
# SM_RR=2.0       # Risk:Reward ratio
# SM_ADX=18.0     # ADX minimum threshold
# SM_HEALTH=70.0  # Health score minimum (0-100)

# ── SmartGridHybrid params (optional) ─────────────────────────────────────────
# SG_SL=1.8       # SL = 1.8×ATR
# SG_HEALTH=70.0  # Health score minimum
# SG_ADX_SW=18.0  # ADX threshold → Swing mode
# SG_ADX_BO=28.0  # ADX threshold → Breakout mode
# SG_ADX_KILL=22.0 # Grid kill switch ADX level
# SG_GRID_LVLS=5  # Max grid levels (auto mode)
# SG_STEP=0.8     # Grid step = 0.8×ATR14

# ── SwingMaster30m params (optional) ──────────────────────────────────────────
# SW_SL=1.8       # SL = 1.8×ATR
# SW_ADX=18.0     # ADX minimum threshold
# SW_HEALTH=70.0  # Health score minimum
# SW_SHORT=false  # true = เปิด Short ด้วย (ใช้กับ futures เท่านั้น)

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=             # @BotFather → /newbot → copy token
TELEGRAM_CHAT_ID=               # ส่งข้อความหา bot แล้วดู /getUpdates

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
