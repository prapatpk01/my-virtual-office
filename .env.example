# ── Exchange ──────────────────────────────────────────────────────────────────
EXCHANGE=okx                    # okx | binance | bybit
EXCHANGE_API_KEY=               # API Key
EXCHANGE_API_SECRET=            # API Secret
EXCHANGE_PASSPHRASE=            # OKX เท่านั้น

# ── Futures config ────────────────────────────────────────────────────────────
PAPER_TRADING=true              # true = ทดสอบ | false = Live
SYMBOLS=BTC/USDT                # คั่นด้วย comma: BTC/USDT,XAU/USDT
LEVERAGE=10                     # leverage (OKX futures)
CANDLE_TF=15m                   # primary TF (entry timeframe)
CANDLE_LIMIT=400                # bars per fetch
INTERVAL_SECONDS=30             # tick ทุก 30 วินาที (เร็วพอสำหรับ 15m TF)

# ── Risk ──────────────────────────────────────────────────────────────────────
TRADE_AMOUNT_USDT=100           # USDT per trade
MAX_POSITIONS=4                 # สูงสุด 4 (BTC_L + BTC_S + XAU_L + XAU_S)
MAX_DRAWDOWN_PCT=0.20           # หยุดถ้า drawdown เกิน 20%
RISK_PER_TRADE=0.01             # 1% ของ balance ต่อ trade

# ── Strategy ──────────────────────────────────────────────────────────────────
STRATEGY_SWING_REVERSAL=true    # SwingReversalPro (Long + Short per symbol)

# ── SwingReversalPro params (optional — defaults tuned) ───────────────────────
# SR_RISK=0.01       # risk fraction per trade (1%)
# SR_L1=5            # min reversal score out of 7
# SR_L2=5            # min context conditions out of 6
# SR_SL=1.0          # min SL = N×ATR14
# SR_ADX4H=35        # 4H ADX must be below this (not strong trend)
# SR_ADX_MIN=15      # skip if 4H ADX below this (no momentum)
# SR_ATR_RATIO=0.8   # skip if ATR14 < ratio × ATR50 (low volatility)
# SR_MTF_LIMIT=50    # MTF bias boundary (-50 for long, +50 for short)

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
