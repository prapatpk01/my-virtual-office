# Virtual Office Configuration
# Copy this file to .env and adjust values for your setup.

# Path to your OpenClaw installation
VO_OPENCLAW_PATH=~/.openclaw

# OpenClaw gateway connection
# Default uses host.docker.internal which works on Linux, Windows, and macOS.
# Override only if your gateway runs on a different host/port.
VO_GATEWAY_URL=ws://host.docker.internal:18789
VO_GATEWAY_HTTP=http://host.docker.internal:18789

# Server ports
VO_PORT=8090
VO_WS_PORT=8091

# Office display name
VO_OFFICE_NAME=Virtual Office

# Weather widget location (optional, e.g. "New+York,NY")
VO_WEATHER_LOCATION=

# Agent Browser VNC password (if using the optional browser service)
# BROWSER_VNC_PASSWORD=changeme

# ── Trading Bot ─────────────────────────────────────────────────────────────
# Leave blank to use paper trading (simulation) mode — no real money at risk.

# Binance (Crypto)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Bybit (Crypto)
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# Alpaca (Stocks / Crypto — paper endpoint used by default)
# ALPACA_API_KEY=
# ALPACA_API_SECRET=

# Claude AI Signal strategy (optional)
# ANTHROPIC_API_KEY=

# Telegram Bot alerts
# 1. Create a bot via @BotFather → /newbot → copy the token
# 2. Send any message to the bot, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
# TELEGRAM_BOT_TOKEN=123456:ABC-xyz
# TELEGRAM_CHAT_ID=987654321

# ── Standalone Bot Runner (run_bot.py / Dockerfile.bot) ─────────────────────
# Used when running the bot WITHOUT the web UI (pure cloud mode)

# ── OKX BTC/USDT 15m Cross Margin x10 — Dual MCDX P1+P2 ───────────────────
# Backtest result: avg WR P1=68.2% / P2=68.1%, combined +$26/25d on $40 capital
# Exchange: binance | bybit | okx | alpaca
EXCHANGE=okx
# EXCHANGE_API_KEY=<your-okx-api-key>
# EXCHANGE_API_SECRET=<your-okx-api-secret>
# EXCHANGE_PASSPHRASE=<your-okx-passphrase>   ← OKX required
PAPER_TRADING=false
# Starting balance for paper trading simulation (USDT)
PAPER_BALANCE=1000

# OKX Cross Margin x10
# Pre-requisite: enable Margin toggle on BTC/USDT in OKX app (no need to borrow manually)
MARGIN_MODE=cross
LEVERAGE=10

# Symbol
SYMBOLS=BTC/USDT

# 15m candles — tick every 15 min (aligned to candle close)
CANDLE_TF=15m
CANDLE_LIMIT=300
INTERVAL_SECONDS=900

# ── Strategies: Dual MCDX P1+P2 (no Sentinel) ───────────────────────────────
STRATEGY_MCDX=true
STRATEGY_SENTINEL=false
STRATEGY_RSI_MACD=false

# Dual-param mode: P1(rv≥0.8) + P2(rv≥1.2), each holds max 1 position
# MCDX_DUAL=true activates two named MCDXStrategy instances (MCDX-P1 / MCDX-P2)
MCDX_DUAL=true
MCDX_DWCS_BUY=57
MCDX_P1_RVOL=0.8
MCDX_P2_RVOL=1.2

# MTF bias: 1H + 4H EMA(21/50) — both must be bullish for a BUY to fire
MTF_FAST_EMA=21
MTF_SLOW_EMA=50

# Risk: SL=1.8%  TP=2.0%  (net RR 1:0.85, BE WR=53.9%, backtest avg WR=68%)
# At 10x: net win=(2.0%-0.25%)×notional  net loss=(1.8%+0.25%)×notional
STOP_LOSS_PCT=0.018
TAKE_PROFIT_PCT=0.020
# 2 positions: one per param set (P1 + P2 can be open simultaneously)
MAX_POSITIONS=2
# Set RISK_PER_TRADE so each position = $20 USDT margin
# e.g. if total capital=$100: 0.20 gives $20/trade; if $200: 0.10 gives $20/trade
RISK_PER_TRADE=0.10

# Max drawdown before bot pauses (default 30%)
# MAX_DRAWDOWN_PCT=0.30

# Minimum confidence to send Telegram alert (0.0 - 1.0)
# TG_MIN_CONFIDENCE=0.5

# Log verbosity: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
