# =============================================================================
# Adaptive Trading Bot — .env  (branch: claude/my-virtual-office-setup-0ndmyj)
# Unified 4H-regime → 1H-context → 15M-entry pipeline (SwingReversal +
# MeanReversion styles chosen per market state). Run standalone on its own
# Railway service with its OWN API key, separate from main's MCDX bot.
# =============================================================================

# ── REQUIRED: turn ON the adaptive bot ───────────────────────────────────────
# Without this the runner does NOT use the adaptive pipeline. MUST be true.
USE_ADAPTIVE=true

# ── Exchange (use a DEDICATED API key — do not share with the other bot) ─────
EXCHANGE=okx                    # okx | binance
EXCHANGE_API_KEY=               # API Key   (read+trade; NOT withdraw)
EXCHANGE_API_SECRET=            # API Secret
EXCHANGE_PASSPHRASE=            # OKX only

PAPER_TRADING=true              # true = demo/paper first | false = LIVE real money
SYMBOLS=BTC/USDT:USDT           # OKX SWAP format, comma-separated for multi:
                                #   BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT
LEVERAGE=20
CANDLE_TF=15m                   # entry timeframe (pipeline is tuned for 15m)
INTERVAL_SECONDS=30             # poll cadence

# ── Adaptive risk / sizing ───────────────────────────────────────────────────
ADAPTIVE_BALANCE=10000          # starting balance (auto-synced from exchange live)
# [SIZING MODE] (live default): classic risk-%-of-balance — position size is
# derived from the SL distance so a full stop-out loses exactly this % of
# CURRENT balance, regardless of leverage/notional/symbol price. Active
# whenever both MARGIN_PCT bounds AND MARGIN_USDT below are 0 (the default).
ADAPTIVE_RISK_PCT=0.05
# [FIXED-$ SIZING] alternative: every trade opens the same notional =
# ADAPTIVE_MARGIN_USDT × LEVERAGE regardless of signal quality or balance.
# Takes precedence over ADAPTIVE_RISK_PCT whenever set >0.
ADAPTIVE_MARGIN_USDT=0
# Per-symbol override for the fixed-$ mode above: ADAPTIVE_MARGIN_USDT_<SYM>
# replaces the default for just that symbol (only relevant when
# ADAPTIVE_MARGIN_USDT>0), e.g.:
# ADAPTIVE_MARGIN_USDT_BTC=50
# [LEVEL 1 — ADAPTIVE RISK] Confidence-weighted %-of-balance sizing instead:
# position size scales between MIN and MAX % of CURRENT balance based on the
# bot's own conviction (score headroom above this state's entry bar,
# penalized by any historically-bad condition tags present). Size compounds
# with balance — bigger bets as balance grows means bigger drawdowns are
# possible too (backtest: MaxDD 5-20% at 8-15%). Takes precedence over both
# modes above whenever both bounds are nonzero.
ADAPTIVE_MARGIN_PCT_MIN=0.0
ADAPTIVE_MARGIN_PCT_MAX=0.0
ADAPTIVE_MAX_POSITIONS=2        # global concurrent position cap
ADAPTIVE_COOLDOWN_MIN=30        # cooldown minutes after loss-streak trip
ADAPTIVE_MAX_LOSS_STREAK=3      # losses before cooldown
ADAPTIVE_DAILY_LOSS_PCT=-3.0    # halt for the day at this daily PnL %
ADAPTIVE_DAILY_PROFIT_PCT=8.0   # stop for the day at this daily PnL %
ADAPTIVE_ENTRY_SPACING_MIN=60   # whipsaw guard: min minutes between OPENs on a symbol (0=off)
ADAPTIVE_WARMUP_MIN=10          # no new entries for this many minutes after a fresh restart (was 45)
# /stats sources its Trades/Win-rate/PnL numbers straight from OKX's own
# post-fill positions-history (realizedPnl there already nets OKX's trading
# + funding fee — matches what OKX itself reports, no local re-derivation).
# Only counts trades closed on/after this date (YYYY-MM-DD, UTC midnight).
ADAPTIVE_STATS_SINCE_DATE=2026-07-16

# ── Adaptive learning (3 levels, no env vars — always on, self-persisting) ───
# Level 0  Diagnostic tagging: every closed trade is tagged with a rule-based
#          cause profile (overextended / rsi_extreme / momentum_climax /
#          low_volume / choppy / trend_to_range) from data already captured
#          at entry — surfaces in the lesson alert's "likely cause" line.
# Level 1  Adaptive Risk: opt-in %-of-balance sizing above
#          (ADAPTIVE_MARGIN_PCT_MIN/MAX) — fixed-$ sizing is the default.
# Level 2  Adaptive Scoring: ConditionLearningEngine tracks win-rate per tag;
#          a candidate resembling a historically bad pattern gets a real
#          score penalty (up to -20) before it's ever taken.
# Level 3  Adaptive Strategy: when one tag causes >=2 of the last 3 losses,
#          a temporary +15 extra penalty activates for 6h, then auto-expires
#          — only ever makes entry MORE cautious, never loosens anything.
# All state persists in the bot's state file (BOT_STATE_DIR) across restarts.

# ── Entry-quality / WR dial (backtest-tuned defaults — change only to retune) ─
# Chop-zone fake-signal filter: min price-to-EMA20 distance in ATR for trend
# entries. 0.6 = default (best cross-symbol result over 5 symbols — enters
# earlier in the move). Higher = stricter/later, higher WR, fewer trades.
# ADAPTIVE_MIN_EMA_DIST_ATR=0.6
# TP geometry (R multiples) — unified 2-target structure (same for every
# state): T1=TP1_R -> close TP1_CLOSE_PCT (60% by default — was documented
# here before but never actually wired up; the live bot always used 75%
# regardless) + SL moves to BREAKEVEN_LOCK_R (locks in a small win instead
# of a flat scratch at exactly entry), T2=TP2_R -> full close of the 40%
# runner left (this is what's attached as the real TP order on OKX). Every
# level fires a Telegram alert.
# ADAPTIVE_TP1_R=0.5
# ADAPTIVE_TP2_R=1.0
ADAPTIVE_TP1_CLOSE_PCT=0.60
ADAPTIVE_BREAKEVEN_LOCK_R=0.15
# Mid-trade protection exits (reversal spike / trend fade / health tiers)
# only act AFTER T1 is banked; before T1 a trade exits at T1 or the hard SL
# only. Set 0 to disable the layer entirely (experiments).
# ADAPTIVE_PROTECT_EXITS=1
# Entry engine: "adaptive" (default) = V9.2 L1/L2/L3/StrategyScorer pipeline.
# "mtf_confluence" = deterministic 4H+1H trend-alignment + 15m 3-signal
# (ROC9 zero-cross, HMA10/20 cross, MACD cross) confluence entry — see
# trading/mtf_confluence_engine.py. Exit management (T1/T2/SL/post-T1
# protection above) is identical either way; only entry direction+timing
# changes. Backtested on real Jan-Jun 2026 data across 8 symbols:
# mtf_confluence net-LOSES on both the tuning set (-$256) and out-of-sample
# (-$528) at this TP/SL geometry — every loss is a full -1R stop, wins
# average only +0.49R, which needs ~67% WR to break even and it only hits
# ~62%. Do not enable in production on this evidence.
# ADAPTIVE_ENTRY_ENGINE=adaptive

# L1 macro trend acceleration — MacroTrendEngine (4H) inherently lags since
# its EMA-cross component needs price to travel far enough to cross a slow
# moving average. Two independent, separately-testable levers:
#
# 1) Early Trend: fold a fast dual-TF (4H+1H) HMA10/20+ROC9+MACD-histogram
#    lean into L1's score, only when BOTH timeframes agree. Backtested on
#    real Jan-Jun 2026 data: MIXED (+$120 OOS, -$114 in-sample, net ~+$6 —
#    a wash). Not currently recommended.
# ADAPTIVE_EARLY_TREND=false
#
# 2) Fast Macro EMA: override L1's EMA20/50 cross/distance component with a
#    faster pair computed fresh from raw 4H candles — doesn't touch
#    IndicatorEngine's shared EMA20/50 used elsewhere. Backtested: +$209
#    combined vs the old EMA20/50, improving BOTH the in-sample (+$51) and
#    out-of-sample (+$157) splits independently. 12/26 (the classic MACD
#    periods) is now the DEFAULT — set FAST=0 (or leave SLOW unset) to
#    restore the old EMA20/50-only behavior instead.
# ADAPTIVE_MACRO_EMA_FAST=12
# ADAPTIVE_MACRO_EMA_SLOW=26

# Pullback filter — max 15m ADX for a Trend entry. Above this the leg is
# treated as already-extended (chasing) and vetoed. This is the single
# biggest entry-frequency knob: at 22 it blocked 41-55% of all Trend-regime
# checks (main reason for long no-trade stretches). Raised to 26 to trade
# more often; higher still = more trades but risks chasing (backtest showed
# ADX>30 entries ran only ~47% WR). Lower back toward 22 to be stricter.
# ADAPTIVE_MAX_15M_ADX_TREND=26

# Minimum SL distance floor — the ATR-based SL (_compute_sl_price) is never
# allowed tighter than this fraction of entry price, regardless of what ATR
# read. Was a single hardcoded 2% for every symbol; split per asset class
# after a live XAU trade showed a -2.00% SL far wider than gold's actual ATR
# called for. First tried crypto=1.2%/commodity=0.8% — 0.8% backtested WORSE
# for XAU/XAG than the old uniform 2% (-$470 combined, every loss a full -1R
# stop — too tight for gold's real ATR). Both now share 1.2%, the value that
# DID backtest better on crypto (+$343).
# ADAPTIVE_MIN_SL_PCT_CRYPTO=0.012
# ADAPTIVE_MIN_SL_PCT_COMMODITY=0.012

# ── Extended commodity-market session control ────────────────────────────────
# Gates NEW entries to the weekly XAU/commodity session (+/- extension
# buffers) to skip the weekend gap. By DEFAULT this applies to COMMODITIES
# ONLY (XAU/XAG/CL) — crypto trades 24/7. Set
# FOLLOW_REFERENCE_SESSION_FOR_CRYPTO=true to also pause crypto on the
# commodity weekend. See trading/session_engine.py. NEVER affects existing-
# position management (SL/TP/trailing/emergency exits, Telegram, exchange
# heartbeat) — only blocks the SCANNING->FILTERING (new-entry) transition.
# Defaults below are the illustrative Sun 18:00 open / Fri 17:00 close
# example — VERIFY against your actual broker/exchange session calendar and
# correct WEEKLY_OPEN_HOUR / WEEKLY_CLOSE_HOUR / weekday vars if different.
# REFERENCE_MARKET=XAU
# MARKET_SESSION_TIMEZONE=America/New_York
# WEEKLY_OPEN_WEEKDAY=SUNDAY
# WEEKLY_OPEN_HOUR=18
# WEEKLY_CLOSE_WEEKDAY=FRIDAY
# WEEKLY_CLOSE_HOUR=17
# PRE_OPEN_EXTENSION_HOURS=3
# POST_CLOSE_EXTENSION_HOURS=3
# FOLLOW_REFERENCE_SESSION_FOR_CRYPTO=false
# Session status (Telegram + Railway log) is announced only on an actual
# state transition (session opens / closes / errors) — not on a timer.

# ── Strategy enable flags (both on = full state coverage) ────────────────────
STRATEGY_SWING_REVERSAL=true    # trend states (EntryHealthScorer)
STRATEGY_MEAN_REVERSION=true    # ranging/exhaustion states (MeanReversion steps)

# ── Monitoring cadence (seconds) ─────────────────────────────────────────────
COOLDOWN_CHECK_SECONDS=300      # re-check cooldown expiry every 5 min
SCAN_LOG_SECONDS=300            # [Adaptive] state log every 5 min
FILTER_STATS_LOG_SECONDS=300    # [FilterStats] rejection summary every 5 min
BALANCE_SYNC_SECONDS=300        # sync real exchange balance every 5 min
RECONCILE_SYNC_SECONDS=300      # detect externally-closed positions every 5 min

# ── State persistence (per-service dir so the two bots never share state) ────
BOT_STATE_DIR=/data             # Railway volume mount; falls back to /tmp

# ── Telegram (use a SEPARATE bot token/chat from the other deployment) ───────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # set DEBUG to see per-bar ENTRY CHECK breakdown
