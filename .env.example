# Virtual Office Configuration
# Copy this file to .env and adjust values for your setup.

# Path to your OpenClaw installation
VO_OPENCLAW_PATH=~/.openclaw

# OpenClaw gateway connection
# Default uses host.docker.internal which works on Linux, Windows, and macOS.
# Override only if your gateway runs on a different host/port.
VO_GATEWAY_URL=ws://host.docker.internal:18789
VO_GATEWAY_HTTP=http://host.docker.internal:18789

# Server ports
VO_PORT=8090
VO_WS_PORT=8091

# Office display name
VO_OFFICE_NAME=Virtual Office

# Weather widget location (optional, e.g. "New+York,NY")
VO_WEATHER_LOCATION=

# Agent Browser VNC password (if using the optional browser service)
# BROWSER_VNC_PASSWORD=changeme

# ── Trading Bot ───────────────────────────────────────────────────────────
# Leave blank to use paper trading (simulation) mode — no real money at risk.

# Binance (Crypto)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Bybit (Crypto)
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# Alpaca (Stocks / Crypto — paper endpoint used by default)
# ALPACA_API_KEY=
# ALPACA_API_SECRET=

# Claude AI Signal strategy (optional)
# ANTHROPIC_API_KEY=

# Telegram Bot alerts
# 1. Create a bot via @BotFather → /newbot → copy the token
# 2. Send any message to the bot, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
# TELEGRAM_BOT_TOKEN=123456:ABC-xyz
# TELEGRAM_CHAT_ID=987654321

# ── Standalone Bot Runner — AI Expert (run_bot.py / Dockerfile.bot) ─────────
# Used when running the bot WITHOUT the web UI (pure cloud mode)

# Exchange: okx | binance | bybit | alpaca
EXCHANGE=okx
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
# EXCHANGE_PASSPHRASE=          # required for OKX; leave blank for Binance/Bybit
PAPER_TRADING=true               # set false for live trading

# ── Perpetual Futures ─────────────────────────────────────────────────────────
FUTURES=true                     # true = perpetual swap; false = spot
LEVERAGE=20                      # leverage multiplier (1–125 depending on exchange)
HEDGE_MODE=true                  # true = hold LONG + SHORT simultaneously (OKX hedge mode)

# Symbols — use perpetual format when FUTURES=true:
#   OKX / Bybit:   BTC/USDT:USDT,ETH/USDT:USDT
#   Binance perp:  BTC/USDT,ETH/USDT (set FUTURES=true)
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT

# Candles & loop
CANDLE_TF=15m
CANDLE_LIMIT=300
INTERVAL_SECONDS=60

# Strategy
STRATEGY=ai_expert
AI_EXPERT_MIN_CONFIDENCE=70     # ignore signals below this (0-100)
AI_EXPERT_STRICT=false

# Position sizing — scales with AI confidence level
SIZE_WEAK=0.08                   # 8%  of balance — WEAK  (score 70-80)
SIZE_GOOD=0.10                   # 10% of balance — GOOD  (score 80-90)
SIZE_HIGH=0.12                   # 12% of balance — HIGH CONVICTION (90+)

# Trade management — tight 1:1.2 R:R strategy
MIN_RR=1.0                       # minimum R:R to accept an entry
TP1_RR=0.6                       # TP1: halfway → close 50% + move SL to break-even
TP2_RR=1.2                       # TP2: full target → close remaining 50%

# Risk limits
MAX_POSITIONS=2
MAX_DRAWDOWN_PCT=0.15            # halt trading if drawdown exceeds 15%
MAX_PORTFOLIO_HEAT=0.06          # max 6% of portfolio at risk at once
MAX_SAME_GROUP=2                 # max 2 positions in same correlation group

# Fallback SL/TP (used when AI doesn't provide price levels)
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.036            # 3% × 1.2R

# Telegram notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
TG_MIN_CONFIDENCE=0.7

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
