# ── Virtual Office ───────────────────────────────────────────────────────────
VO_GATEWAY_URL=ws://host.docker.internal:18789
VO_GATEWAY_HTTP=http://host.docker.internal:18789
VO_PORT=8090
VO_WS_PORT=8091
VO_OFFICE_NAME=Virtual Office
VO_WEATHER_LOCATION=

# ── Exchange ──────────────────────────────────────────────────────────────────
# exchange: binance | bybit | okx | alpaca | oanda
EXCHANGE=okx
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSPHRASE=          # OKX only

# OANDA (Forex/Gold — optional)
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_ENV=practice          # practice | live

# ── Trading mode ──────────────────────────────────────────────────────────────
PAPER_TRADING=true            # true = no real orders, safe for testing
SYMBOLS=BTC/USDT
CANDLE_TF=1h                  # timeframe for strategy signals: 1h | 4h | 15m
CANDLE_LIMIT=300              # bars to fetch per tick
INTERVAL_SECONDS=3600         # tick interval — match CANDLE_TF (3600=1h, 900=15m)
LEVERAGE=1                    # 1 = spot, 5 = margin×5, 10 = margin×10 (OKX only)
MARGIN_MODE=isolated          # isolated = per-trade risk; cross = shared pool

# ── Strategies ────────────────────────────────────────────────────────────────
STRATEGY_WT_ADX=true          # WaveTrend — WR≈74.6% (optimized)
STRATEGY_MACD_EMA=true        # MACD/EMA  — WR≈66.7%
STRATEGY_MOMENTUM_SCORE=true  # Momentum  — WR≈67.6%
STRATEGY_UT_BOT=true          # UT Bot    — WR≈74.0%
STRATEGY_KNN=false            # kNN ML    — needs 1000+ bars; enable after testing

# ── MTF 4H bias gate (blocks BUY when 4H trend is bearish) ───────────────────
MTF_GATE=true                 # true | false — disable if connector has no 4H data

# ── Strategy parameter overrides (optional — defaults are already optimized) ──
# WaveTrend
# WT_N1=8
# WT_N2=12
# WT_SL=1.5
# WT_RR=1.0

# MACD/EMA
# MACD_SL=1.5
# MACD_RR=1.0

# Momentum Score
# MOM_THR=4
# MOM_RE=5
# MOM_SL=1.5
# MOM_RR=1.0

# UT Bot
# UT_MULT=0.3
# UT_LEN=14
# UT_SL=1.5
# UT_RR=1.0

# ── Risk management ───────────────────────────────────────────────────────────
TRADE_AMOUNT_USDT=0           # fixed $ per trade (0 = use RISK_PER_TRADE % instead)
RISK_PER_TRADE=0.02           # fraction of balance risked per trade (2%)
STOP_LOSS_PCT=0.03            # fallback SL % (strategies use ATR-based SL)
TAKE_PROFIT_PCT=0.06          # fallback TP %
MAX_POSITIONS=3
MAX_DRAWDOWN_PCT=0.30         # halt trading if drawdown exceeds 30%

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create bot: @BotFather → /newbot → copy token
# Get chat_id: send message to bot, then GET /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TG_MIN_CONFIDENCE=0.5         # minimum signal confidence to send alert (0–1)

# ── Forex/Gold signal-only mode ───────────────────────────────────────────────
FOREX_SYMBOLS=XAUUSD
FOREX_SIGNALS=true
FOREX_INTERVAL_SECONDS=3600

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
