# Unified trading-bot image — ALL systems baked in, chosen by env MODE:
#   MODE=ema_hybrid -> EMA Hybrid Pro (production default)
#   MODE=dual       -> DUAL ENTRY PRECISION V1.4
#   MODE=regime     -> Signal Regime Bias bot (legacy)
#   MODE=htf        -> HTF pullback bot
#   MODE=tpc        -> Trend Pullback Continuation / HMA bot
# /app/main.py is the launcher; MODE selects the runtime.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

# Superset of the trading systems' dependencies.
COPY signal_regime_bot/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY signal_regime_bot/ signal_regime_bot/
COPY dual_entry_v14/ dual_entry_v14/
COPY htf_bot/ htf_bot/
COPY hma_bot/ hma_bot/
COPY ema_hybrid_bot/ ema_hybrid_bot/
COPY launcher.py main.py

# Railway can override MODE explicitly for another runtime. If it is omitted,
# this image must run the EMA Hybrid bot rather than silently starting DUAL.
ENV MODE=ema_hybrid

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s \
  CMD python -c "import os, sys; sys.exit(0)"

CMD ["python", "main.py"]
