FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libxml2-dev libxslt-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-trading.txt .
RUN pip install --no-cache-dir -r requirements-trading.txt

COPY app/trading/ ./trading/
COPY app/run_bot.py .
COPY app/run_dual_bot.py .
COPY app/run_enhanced_dual_bot.py .
COPY app/run_trendconfirm_utbot.py .
COPY app/run_strategy_router.py .

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s \
  CMD python -c "import os, sys; sys.exit(0)"

# Canonical production: one Simple Precision strategy (4H -> 1H -> 15M).
CMD ["python", "run_strategy_router.py"]
