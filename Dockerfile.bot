# Unified trading-bot image — BOTH systems baked in, chosen by env MODE:
#   MODE=dual    -> DUAL ENTRY PRECISION V1.4  (default)
#   MODE=regime  -> Signal Regime Bias bot (legacy)
# /app/main.py IS the launcher, so any start command Railway has configured
# ("python main.py", image CMD, or railway.json startCommand) all route
# through the same MODE switch.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

# superset of both systems' dependencies
COPY signal_regime_bot/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY signal_regime_bot/ signal_regime_bot/
COPY dual_entry_v14/ dual_entry_v14/
COPY launcher.py main.py

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s \
  CMD python -c "import os, sys; sys.exit(0)"

CMD ["python", "main.py"]
