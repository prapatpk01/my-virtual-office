# Sentinel Global Fund — Web App env
# ────────────────────────────────────────────────
# Shared team password (ทุกคนใช้รหัสเดียวกัน)
APP_PASSWORD=change-me-please

# Session signing secret (สุ่มยาว ๆ)
SECRET_KEY=replace-with-a-long-random-string

# Postgres — Railway ใส่ให้อัตโนมัติเมื่อ add Postgres plugin
# ในเครื่อง dev ถ้าไม่ตั้ง จะ fallback เป็น SQLite (fund.db)
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# ชื่อกองทุน (แสดงบน UI)
FUND_NAME=Sentinel Global Fund
